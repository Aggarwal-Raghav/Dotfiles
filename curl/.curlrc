# TIP: If you ever want to bypass this config file completely,
# run curl with the -q flag as the VERY FIRST argument (e.g., `curl -q http...`)

# Always follow HTTP redirects (301, 302, etc.). This prevents curl from
# failing silently when an API or website has moved.
location

# Display a beautiful, clean progress bar [#####     ] instead of the
# confusing default statistical progress meter table.
progress-bar

# When you use `curl -s` (silent mode) in scripts, curl hides ALL output.
# This flag ensures that if an ERROR happens, it still prints the error message!
show-error

# Prevent curl from hanging infinitely if a server is completely dead
connect-timeout = 30

# Automatically retry 3 times if the connection drops unexpectedly
retry = 3

# Wait 2 seconds between those retries
retry-delay = 2

# ====================================================================
# cURL CHEAT SHEET:
# ====================================================================
# -s               : Silent mode (hides the progress meter)
# -L               : Follow redirects (301/302)
# -k               : Insecure mode (bypasses SSL/TLS certificate checks)
# -#               : Show a clean [#####] progress bar instead of the default table
# -u "user:pass"   : Pass Basic Authentication credentials

# -I               : Fetch HTTP headers only (great for debugging servers/caches)
# -o <file>        : Save output to a specific custom filename/path
# -O               : Save output using the original remote filename (current dir)
# -O --output-dir  : Save output using original filename but into a specific folder
# -d '{"x": "y"}'  : Send JSON data (automatically changes request to POST)
# -H "Key: Val"    : Pass a custom HTTP header (like Authorization or Content-Type)
#
# Useful commands:
# > curl ifconfig.me                             (Get your public IP address)
# > curl https://api.site.com | jq               (Pretty-print JSON APIs)
# > curl -w "DNS: %{time_namelookup}s, Connect: %{time_connect}s, TTFB: %{time_starttransfer}s\n" -o /dev/null -s https://...
# > curl cht.sh/curl~JSON                        (Search cht.sh for examples of JSON)
# > curl "cht.sh/curl~-O"                        (Search cht.sh for examples of a specific flag)
# > curl --help all | rg " -L"                   (Look up the official definition of a flag)

# ====================================================================
#
# Want more? Check out the ultimate cheat sheets:
# - cURL: https://cht.sh/curl (Run `curl cht.sh/curl` directly in your terminal!)
# - xh (HTTPie alternative): https://github.com/ducaale/xh
